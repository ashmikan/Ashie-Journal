---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ashie", description = "Literary Journal" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="/logo.png"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FAF7F2" />

    <!-- Google Fonts: Playfair Display (Serif), Plus Jakarta Sans (Sans-Serif), Caveat (Script) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#FAF7F2] text-[#2B2523] font-sans antialiased min-h-screen selection:bg-[#F8D7DF] selection:text-[#2B2523]"
  >
    <!-- 3 Second Page Loader -->
    <div id="page-loader" class="fixed inset-0 z-[9999] bg-[#FAF7F2] flex flex-col items-center justify-center transition-opacity duration-700 overflow-hidden">
      <!-- Background Image with Reduced Opacity -->
      <img src="/images/3.jpg" alt="" class="absolute inset-0 w-full h-full object-cover z-0 opacity-20" loading="eager" />
      
      <!-- Loader Content -->
      <div class="relative z-10 w-12 h-12 border-4 border-[#F4CCD6] border-t-[#C76B80] rounded-full animate-spin mb-4 shadow-sm"></div>
      <p class="relative z-10 font-serif text-[#C76B80] font-semibold tracking-widest uppercase text-sm animate-pulse">Loading Ashie journal... </p>
    </div>
    <script>
      // Disable loader after 3 seconds
      setTimeout(() => {
        const loader = document.getElementById('page-loader');
        if (loader) {
          loader.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => {
            loader.remove();
          }, 700);
        }
      }, 3000);
    </script>

    <!-- Header -->
    <header
      class="w-full border-b border-[#EFE5DE]/60 bg-[#FAF7F2]/90 backdrop-blur-md sticky top-0 z-50 transition-all duration-300"
    >
      <div
        class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4"
      >
        <!-- Logo on the Left -->
        <a
          href="/"
          class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#DF8A9C] rounded-xl p-1"
        >
          <!-- Logo Image -->
          <img
            src="/logo.png"
            alt="Ashie Journal Logo"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover shadow-2xs group-hover:scale-105 group-hover:rotate-3 transition-transform duration-300 ring-1 ring-[#F4CCD6]/60 bg-white"
            width="44"
            height="44"
          />

          <!-- Text Branding -->
          <div class="flex flex-col">
            <div class="flex items-baseline gap-1.5">
              <span
                class="font-serif font-bold text-xl sm:text-2xl text-[#2B2523] tracking-tight group-hover:text-[#C76B80] transition-colors"
              >
                Ashie
              </span>
              <span
                class="font-script text-lg sm:text-xl text-[#DF8A9C] tracking-wide"
              >
                Journal
              </span>
            </div>
            <span
              class="text-[9px] uppercase tracking-[0.24em] text-[#8C807B] font-semibold -mt-0.5"
            >
              LINGERING WORDS
            </span>
          </div>
        </a>

        <!-- "Share your thoughts" Action Button on the Right -->
        <a
          href="#thoughts"
          class="inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white/95 hover:bg-white text-[#4A403D] hover:text-[#C76B80] text-xs sm:text-sm font-medium border border-[#E9DDD7] hover:border-[#F4C4D0] shadow-xs hover:shadow-md transition-all duration-200 active:scale-95"
        >
          <svg
            class="w-3.5 h-3.5 text-[#DF8A9C]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
            ></path>
          </svg>
          <span>Share your thoughts</span>
        </a>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="w-full">
      <slot />
    </main>

    <!-- Scroll to Top Button -->
    <div id="scrollToTopWrapper" class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-50 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none">
      <button
        id="scrollToTopBtn"
        class="animate-bounce p-3 sm:p-3.5 rounded-full bg-white text-[#C76B80] border border-[#F4CCD6] shadow-[0_8px_20px_rgba(200,160,170,0.25)] hover:shadow-[0_12px_25px_rgba(200,160,170,0.35)] hover:bg-[#FCF0F3] transition-colors duration-300 cursor-pointer"
        aria-label="Scroll to top"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
        </svg>
      </button>
    </div>

    <script>
      const wrapper = document.getElementById("scrollToTopWrapper");
      const btn = document.getElementById("scrollToTopBtn");
      
      window.addEventListener("scroll", () => {
        if (window.scrollY > 300) {
          wrapper.classList.remove("opacity-0", "translate-y-10", "pointer-events-none");
          wrapper.classList.add("opacity-100", "translate-y-0");
        } else {
          wrapper.classList.add("opacity-0", "translate-y-10", "pointer-events-none");
          wrapper.classList.remove("opacity-100", "translate-y-0");
        }
      });

      btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
