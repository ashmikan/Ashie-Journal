---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Ashie", description = "Literary Journal" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/png"
      href="/logo.png"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#FAF7F2" />

    <!-- Google Fonts: Playfair Display (Serif), Plus Jakarta Sans (Sans-Serif), Caveat (Script) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[#FAF7F2] text-[#2B2523] font-sans antialiased min-h-screen selection:bg-[#F8D7DF] selection:text-[#2B2523]"
  >
    <!-- Page Loader / Enter Screen -->
    <div id="page-loader" class="fixed inset-0 z-[9999] bg-[#FAF7F2] flex flex-col items-center justify-center transition-opacity duration-700 overflow-hidden">
      <!-- Background Image with Reduced Opacity -->
      <img src="/images/3.jpg" alt="" class="absolute inset-0 w-full h-full object-cover z-0 opacity-20" loading="eager" />
      
      <!-- Loader Content -->
      <div id="loader-content" class="flex flex-col items-center transition-opacity duration-500">
        <div class="relative z-10 w-12 h-12 border-4 border-[#F4CCD6] border-t-[#C76B80] rounded-full animate-spin mb-4 shadow-sm"></div>
        <p class="relative z-10 font-serif text-[#C76B80] font-semibold tracking-widest uppercase text-sm animate-pulse">Loading Ashie journal... </p>
      </div>

      <!-- Enter Button (Hidden initially) -->
      <button id="enter-btn" class="opacity-0 hidden relative z-10 px-8 py-3 bg-white/90 backdrop-blur-sm border border-[#C76B80] text-[#C76B80] font-serif font-semibold tracking-widest uppercase text-sm rounded-full shadow-[0_8px_20px_rgba(200,160,170,0.2)] hover:bg-[#C76B80] hover:text-white hover:shadow-[0_12px_25px_rgba(200,160,170,0.4)] transition-all duration-500 transform hover:-translate-y-1">
        Open the Journal ✍🏼
      </button>
    </div>
    <script>
      // Show "Enter" button after brief loading (1.5 seconds)
      setTimeout(() => {
        const loaderContent = document.getElementById('loader-content');
        const enterBtn = document.getElementById('enter-btn');
        
        if (loaderContent && enterBtn) {
          loaderContent.classList.add('hidden');
          enterBtn.classList.remove('hidden');
          // Small delay to allow display:block to apply before changing opacity for smooth fade-in
          setTimeout(() => {
            enterBtn.classList.remove('opacity-0');
          }, 50);
        }
      }, 1500);

      // Handle Enter button click to guarantee music starts
      const enterBtn = document.getElementById('enter-btn');
      if (enterBtn) {
        enterBtn.addEventListener('click', () => {
          // Play music (guaranteed to work because it's triggered by user click)
          const audio = document.getElementById('bg-music') as HTMLAudioElement | null;
          if (audio) {
            audio.play().catch(e => console.log("Audio play failed:", e));
          }

          // Hide loader overlay
          const loader = document.getElementById('page-loader');
          if (loader) {
            loader.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
              loader.remove();
            }, 700);
          }
        });
      }
    </script>

    <!-- Header -->
    <header
      class="w-full border-b border-[#EFE5DE]/60 bg-[#FAF7F2]/90 backdrop-blur-md sticky top-0 z-50 transition-all duration-300"
    >
      <div
        class="max-w-5xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4"
      >
        <!-- Logo on the Left -->
        <a
          href="#hero"
          id="brandLogoLink"
          aria-label="Ashie Journal - Go to Hero section"
          class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#DF8A9C] rounded-xl p-1 cursor-pointer"
        >
          <!-- Logo Image -->
          <img
            src="/logo.png"
            alt="Ashie Journal Logo"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover shadow-2xs group-hover:scale-105 group-hover:rotate-3 transition-transform duration-300 ring-1 ring-[#F4CCD6]/60 bg-white"
            width="44"
            height="44"
          />

          <!-- Text Branding -->
          <div class="flex flex-col">
            <div class="flex items-baseline gap-1.5">
              <span
                class="font-serif font-bold text-xl sm:text-2xl text-[#2B2523] tracking-tight group-hover:text-[#C76B80] transition-colors"
              >
                Ashie
              </span>
              <span
                class="font-script text-lg sm:text-xl text-[#DF8A9C] tracking-wide"
              >
                Journal
              </span>
            </div>
            <span
              class="text-[9px] uppercase tracking-[0.24em] text-[#8C807B] font-semibold -mt-0.5"
            >
              LINGERING WORDS
            </span>
          </div>
        </a>

        <!-- "Share your thoughts" Action Button on the Right -->
        <a
          href="#thoughts"
          class="inline-flex items-center gap-2 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full bg-white/95 hover:bg-white text-[#4A403D] hover:text-[#C76B80] text-xs sm:text-sm font-medium border border-[#E9DDD7] hover:border-[#F4C4D0] shadow-xs hover:shadow-md transition-all duration-200 active:scale-95"
        >
          <svg
            class="w-3.5 h-3.5 text-[#DF8A9C]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
            ></path>
          </svg>
          <span>Share your thoughts</span>
        </a>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="w-full">
      <slot />
    </main>

    <!-- Scroll to Top Button -->
    <div id="scrollToTopWrapper" class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-50 transition-all duration-300 opacity-0 translate-y-10 pointer-events-none">
      <button
        id="scrollToTopBtn"
        class="animate-bounce p-3 sm:p-3.5 rounded-full bg-white text-[#C76B80] border border-[#F4CCD6] shadow-[0_8px_20px_rgba(200,160,170,0.25)] hover:shadow-[0_12px_25px_rgba(200,160,170,0.35)] hover:bg-[#FCF0F3] transition-colors duration-300 cursor-pointer"
        aria-label="Scroll to top"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
        </svg>
      </button>
    </div>

    <!-- Floating Audio Player -->
    <div class="fixed bottom-6 left-6 sm:bottom-8 sm:left-8 z-50 transition-all duration-300">
      <audio id="bg-music" src="/1.mp3" loop autoplay preload="auto"></audio>
      <button
        id="musicToggleBtn"
        class="p-3 sm:p-3.5 rounded-full bg-white text-[#C76B80] border border-[#F4CCD6] shadow-[0_8px_20px_rgba(200,160,170,0.25)] hover:shadow-[0_12px_25px_rgba(200,160,170,0.35)] hover:bg-[#FCF0F3] transition-colors duration-300 cursor-pointer flex items-center justify-center relative group"
        aria-label="Toggle background music"
      >
        <!-- SVG Play Icon -->
        <svg id="playIcon" class="w-5 h-5 sm:w-6 sm:h-6 transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <!-- SVG Pause Icon (hidden by default) -->
        <svg id="pauseIcon" class="w-5 h-5 sm:w-6 sm:h-6 hidden transition-transform duration-300 group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        
        <!-- Tooltip -->
        <span id="musicTooltip" class="absolute left-full ml-4 px-3 py-1.5 bg-white text-[#4A403D] text-xs font-medium rounded-lg shadow-md border border-[#E9DDD7] opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap pointer-events-none">
          Play Music
        </span>
      </button>
    </div>

    <script>
      // Scroll to Top Logic
      const wrapper = document.getElementById("scrollToTopWrapper");
      const btn = document.getElementById("scrollToTopBtn");
      
      if (wrapper && btn) {
        window.addEventListener("scroll", () => {
          if (window.scrollY > 300) {
            wrapper.classList.remove("opacity-0", "translate-y-10", "pointer-events-none");
            wrapper.classList.add("opacity-100", "translate-y-0");
          } else {
            wrapper.classList.add("opacity-0", "translate-y-10", "pointer-events-none");
            wrapper.classList.remove("opacity-100", "translate-y-0");
          }
        });

        btn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // Brand Logo smooth scroll to Hero section without refreshing
      const brandLogo = document.getElementById("brandLogoLink");
      if (brandLogo) {
        brandLogo.addEventListener("click", (e) => {
          const heroEl = document.getElementById("hero");
          if (heroEl) {
            e.preventDefault();
            heroEl.scrollIntoView({ behavior: "smooth" });
            if (window.location.hash !== "#hero") {
              history.pushState(null, "", "#hero");
            }
          }
        });
      }

      // Audio Player Logic
      const audio = document.getElementById("bg-music") as HTMLAudioElement | null;
      const musicBtn = document.getElementById("musicToggleBtn");
      const playIcon = document.getElementById("playIcon");
      const pauseIcon = document.getElementById("pauseIcon");
      const tooltip = document.getElementById("musicTooltip");

      if (musicBtn && audio && playIcon && pauseIcon && tooltip) {
        // Start at a pleasant ambient volume
        audio.volume = 0.5;

        // Function to update UI based on audio state
        const updateUI = () => {
          if (audio.paused) {
            playIcon.classList.remove("hidden");
            pauseIcon.classList.add("hidden");
            tooltip.textContent = "Play Music";
            musicBtn.classList.remove("animate-pulse");
          } else {
            playIcon.classList.add("hidden");
            pauseIcon.classList.remove("hidden");
            tooltip.textContent = "Pause Music";
            musicBtn.classList.add("animate-pulse");
          }
        };

        // Listen to native audio events to keep UI in sync
        audio.addEventListener("play", updateUI);
        audio.addEventListener("pause", updateUI);
        audio.addEventListener("ended", updateUI);

        // Initial sync
        updateUI();

        // Attempt programmatic auto-play as a fallback
        const playPromise = audio.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {
            // Auto-play was blocked. UI will stay in paused state.
            console.log("Auto-play blocked by browser. User interaction required to play.");
          });
        }

        musicBtn.addEventListener("click", () => {
          if (audio.paused) {
            audio.play().catch(e => console.log("Audio play failed:", e));
          } else {
            audio.pause();
          }
        });
      }
    </script>
  </body>
</html>
