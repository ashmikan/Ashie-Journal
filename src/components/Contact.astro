---
// Contact.astro - Contact dispatch and "Share your thoughts" submission card
---

<footer
  id="contact"
  class="max-w-5xl mx-auto px-4 sm:px-6 pt-10 pb-16 md:pt-14 md:pb-20"
>
  <!-- Two-Column Grid Layout for Desktop, Stacking on Mobile -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
    <!-- Left Column: Direct Dispatch & Contact Details (5 cols on lg) -->
    <div class="lg:col-span-5 flex flex-col justify-between h-full pt-2">
      <div>
        <!-- Label Badge -->
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FAF0F3] border border-[#F5CCD6] text-[10px] sm:text-[11px] font-semibold tracking-[0.2em] uppercase text-[#C76B80] mb-4"
        >
          <span>DIRECT DISPATCH</span>
        </div>

        <!-- Heading -->
        <h2
          class="font-serif text-3xl sm:text-4xl md:text-5xl text-[#2B2523] font-bold tracking-tight mb-4"
        >
          Let's Talk
        </h2>

        <!-- Italicized Quote / Intro -->
        <p
          class="font-serif italic text-sm sm:text-base text-[#5A504D] leading-relaxed mb-8"
        >
          “Words, once printed or written, leave a quiet life of their own.”
          Reach out for collaborations, quote discussions, or quiet book chats.
        </p>

        <!-- Contact Items with Icons -->
        <div class="space-y-4">
          <!-- Email Item -->
          <a
            href="mailto:hello@ashiequotes.com"
            class="group flex items-center gap-3.5 p-2 -ml-2 rounded-2xl hover:bg-white/60 transition-all duration-200"
          >
            <div
              class="w-10 h-10 rounded-full bg-[#FAF0F3] border border-[#F4CCD6] flex items-center justify-center text-[#C76B80] group-hover:bg-[#F9E2E8] group-hover:scale-105 transition-all"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <span
                class="block text-xs uppercase tracking-wider text-[#988C88] font-semibold"
                >Email</span
              >
              <span
                class="text-sm sm:text-base text-[#2B2523] font-medium group-hover:text-[#C76B80] transition-colors"
              >
                ashmika.nathali123@gmail.com
              </span>
            </div>
          </a>

          <!-- Location Item -->
          <div class="flex items-center gap-3.5 p-2 -ml-2">
            <div
              class="w-10 h-10 rounded-full bg-[#FAF0F3] border border-[#F4CCD6] flex items-center justify-center text-[#C76B80]"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <span
                class="block text-xs uppercase tracking-wider text-[#988C88] font-semibold"
                >Location</span
              >
              <span class="text-sm sm:text-base text-[#2B2523] font-medium">
                Kalutara, Sri Lanka
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Decorative Italicized Quote -->
      <div class="mt-8 pt-6 border-t border-[#EDE1DC]">
        <p
          class="font-serif italic text-xs sm:text-sm text-[#C76B80] leading-relaxed"
        >
          “Every letter sent, is a tender bridge between kindred spirits.”
        </p>
      </div>
    </div>

    <!-- Right Column: White Rounded "Share your thoughts" Form Card (7 cols on lg) -->
    <div id="thoughts" class="lg:col-span-7">
      <div
        class="bg-white rounded-3xl p-6 sm:p-9 md:p-10 shadow-[0_15px_45px_rgba(215,180,185,0.14)] border border-[#F3ECE8] relative transition-all duration-300"
      >
        <!-- Header Row -->
        <div class="flex items-center justify-between gap-4 mb-2">
          <h3
            class="font-serif text-2xl sm:text-3xl text-[#2B2523] font-bold tracking-tight"
          >
            Share your thoughts
          </h3>
          <span
            class="font-script text-xl sm:text-2xl text-[#C76B80] select-none"
          >
            with love ♡
          </span>
        </div>

        <!-- Subtitle -->
        <p class="text-xs sm:text-sm text-[#7D716D] mb-7 font-sans">
          Share with me a quote that made your heart stop!
        </p>

        <!-- Form -->
        <form id="thoughts-form" class="space-y-4 sm:space-y-5">
          <!-- Web3Forms Access Key -->
          <input
            type="hidden"
            name="access_key"
            value="567e367e-f5af-4bda-bf1c-79c052b3deaf"
          />
          <input
            type="hidden"
            name="subject"
            value="New Quote Submission from Ashie Journal"
          />
          <input
            type="hidden"
            name="from_name"
            value="Ashie Journal Sanctuary"
          />
          <!-- Name Field -->
          <div>
            <label
              for="name"
              class="block text-[11px] font-bold uppercase tracking-wider text-[#4A403D] mb-1.5"
            >
              NAME
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Your Name (or reader/pen name)"
              class="w-full px-4 py-3 rounded-xl sm:rounded-2xl bg-[#FCFAF8] border border-[#ECE0DB] text-sm text-[#2B2523] placeholder-[#A89D98] focus:bg-white focus:border-[#DF8A9C] focus:ring-2 focus:ring-[#F8D7DF] focus:outline-none transition-all duration-200"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label
              for="email"
              class="block text-[11px] font-bold uppercase tracking-wider text-[#4A403D] mb-1.5"
            >
              EMAIL
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your.email@example.com"
              class="w-full px-4 py-3 rounded-xl sm:rounded-2xl bg-[#FCFAF8] border border-[#ECE0DB] text-sm text-[#2B2523] placeholder-[#A89D98] focus:bg-white focus:border-[#DF8A9C] focus:ring-2 focus:ring-[#F8D7DF] focus:outline-none transition-all duration-200"
            />
          </div>

          <!-- Quote Field -->
          <div>
            <label
              for="quote"
              class="block text-[11px] font-bold uppercase tracking-wider text-[#4A403D] mb-1.5"
            >
              QUOTE
            </label>
            <textarea
              id="quote"
              name="quote"
              rows="3"
              required
              placeholder="Enter the quote that stayed with you..."
              class="w-full px-4 py-3 rounded-xl sm:rounded-2xl bg-[#FCFAF8] border border-[#ECE0DB] text-sm text-[#2B2523] placeholder-[#A89D98] focus:bg-white focus:border-[#DF8A9C] focus:ring-2 focus:ring-[#F8D7DF] focus:outline-none transition-all duration-200 resize-none font-serif italic"
            ></textarea>
          </div>

          <!-- Novel / Author Field -->
          <div>
            <label
              for="novelAuthor"
              class="block text-[11px] font-bold uppercase tracking-wider text-[#4A403D] mb-1.5"
            >
              NOVEL / AUTHOR
            </label>
            <input
              type="text"
              id="novelAuthor"
              name="novelAuthor"
              placeholder="e.g. The Picture of Dorian Gray - Oscar Wilde"
              class="w-full px-4 py-3 rounded-xl sm:rounded-2xl bg-[#FCFAF8] border border-[#ECE0DB] text-sm text-[#2B2523] placeholder-[#A89D98] focus:bg-white focus:border-[#DF8A9C] focus:ring-2 focus:ring-[#F8D7DF] focus:outline-none transition-all duration-200"
            />
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 px-6 rounded-xl sm:rounded-2xl bg-[#DF8A9C] hover:bg-[#D4798D] active:scale-[0.99] text-white font-medium text-sm sm:text-base tracking-wide shadow-md shadow-[#DF8A9C]/30 hover:shadow-lg hover:shadow-[#DF8A9C]/40 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer group"
            >
              <span>Submit Quote & Thoughts</span>
              <span
                class="transition-transform duration-200 group-hover:translate-x-1"
                >→</span
              >
            </button>
          </div>

          <!-- Feedback message container -->
          <div
            id="form-feedback"
            class="hidden p-4 rounded-xl bg-[#FAF0F3] border border-[#F4CCD6] text-center text-xs sm:text-sm text-[#B2536A] font-serif italic"
          >
            Thank you for sharing your piece of heart. It has been recorded into
            the journal sanctuary. ♡
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Bottom Divider Line -->
  <div
    class="mt-16 pt-8 border-t border-[#ECE0DA] flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left"
  >
    <!-- Copyright Text -->
    <div class="flex items-center justify-center sm:justify-start gap-2.5">
      <img
        src="/logo.png"
        alt="Ashie Journal"
        class="w-6 h-6 rounded-full object-cover ring-1 ring-[#F4CCD6]/50 bg-white"
        width="24"
        height="24"
      />
      <p class="text-xs text-[#8C807B] font-sans">
        © 2026 Ashie' Literary Journal. Crafted with love & ink.
      </p>
    </div>

    <!-- Social Media Icon Links Aligned to the Right -->
    <div class="flex items-center gap-3.5 sm:gap-4">
      <!-- Facebook -->
      <a
        href="https://www.facebook.com/share/1CskJU716n/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-[#FDECEF] text-[#423B38] hover:text-[#C76B80] flex items-center justify-center transition-all duration-300 shadow-[0_10px_20px_rgba(240,140,165,0.42)] hover:shadow-[0_12px_24px_rgba(235,130,155,0.55)] hover:-translate-y-0.5 hover:scale-105 active:scale-95"
      >
        <svg
          class="w-3.5 h-3.5 sm:w-4 sm:h-4"
          viewBox="0 0 320 512"
          fill="currentColor"
        >
          <path
            d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"
          ></path>
        </svg>
      </a>

      <!-- Instagram -->
      <a
        href="https://instagram.com/ashmika.nathali"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-[#FDECEF] text-[#423B38] hover:text-[#C76B80] flex items-center justify-center transition-all duration-300 shadow-[0_10px_20px_rgba(240,140,165,0.42)] hover:shadow-[0_12px_24px_rgba(235,130,155,0.55)] hover:-translate-y-0.5 hover:scale-105 active:scale-95"
      >
        <svg
          class="w-4 h-4 sm:w-[17px] sm:h-[17px]"
          viewBox="0 0 448 512"
          fill="currentColor"
        >
          <path
            d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
          ></path>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://linkedin.com/in/ashmika-nathali-3290132ab"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-[#FDECEF] text-[#423B38] hover:text-[#C76B80] flex items-center justify-center transition-all duration-300 shadow-[0_10px_20px_rgba(240,140,165,0.42)] hover:shadow-[0_12px_24px_rgba(235,130,155,0.55)] hover:-translate-y-0.5 hover:scale-105 active:scale-95"
      >
        <svg
          class="w-3.5 h-3.5 sm:w-4 sm:h-4"
          viewBox="0 0 448 512"
          fill="currentColor"
        >
          <path
            d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>

<script>
  // Web3Forms asynchronous form submission handler
  const form = document.getElementById(
    "thoughts-form",
  ) as HTMLFormElement | null;
  const feedback = document.getElementById("form-feedback");
  const submitBtn = document.getElementById("submit-btn");

  if (form && feedback && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Check if user still has placeholder key
      const keyInput = form.querySelector(
        'input[name="access_key"]',
      ) as HTMLInputElement | null;
      if (keyInput && keyInput.value === "YOUR_ACCESS_KEY_HERE") {
        feedback.classList.remove("hidden");
        feedback.textContent =
          "Please replace YOUR_ACCESS_KEY_HERE with your free access key from https://web3forms.com in Contact.astro.";
        return;
      }

      // Update button state to loading
      submitBtn.setAttribute("disabled", "true");
      submitBtn.classList.add("opacity-75");
      submitBtn.innerHTML = `<span>Sending your words... ♡</span>`;

      const formData = new FormData(form);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (result.success) {
          feedback.classList.remove("hidden");
          feedback.textContent =
            "Thank you for sharing your piece of heart. It has been delivered into the journal sanctuary. ♡";
          form.reset();
          
          // Play the submit success sound
          const submitSound = new Audio("/Submit.mp3");
          submitSound.play().catch(e => console.log("Error playing submit sound:", e));
        } else {
          feedback.classList.remove("hidden");
          feedback.textContent =
            result.message ||
            "Something went wrong. Please check your access key.";
        }
      } catch (error) {
        feedback.classList.remove("hidden");
        feedback.textContent =
          "Unable to connect. Please check your internet connection.";
      } finally {
        submitBtn.removeAttribute("disabled");
        submitBtn.classList.remove("opacity-75");
        submitBtn.innerHTML = `<span>Submit Quote & Thoughts</span> <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>`;
      }
    });
  }
</script>
