    quoteText: "දවස් පහසුවෙන් ගෙවෙයි, ප්‍රියේ ! \nඔබට කියන්නට වැදගත් යමක් නැත. \nසියුම් දුකක් ඇත්නම් ඔබේ මුහුණුවර කෙමෙන් කෙමෙන් බොඳව යෑමය. \nහිස්තැනක් සේ පෙනීමය. \nඅවසානයේ.. නුඹේ මතකය පවා මා හැර ගිය දාක \nමා පවා නාඳුනන අයෙක් මා ළඟ ඉතුරු වීමය.",
    author: "Warana Rasika Gunawardana",
    likes: "",
    alignment: "left" as const,
    bgImage: "/images/25.jpeg",
  },
  {
    id: "quote-26",
    tag: "#26 • READING NOTES",
    quoteText: "My Dearest Emma, for dearest you will always be. My dearest, most beloved Emma, tell me at once. I cannot make speeches. If I..If I loved you less then I might be able to talk about it more.",
    author: "Emma 2020",
    likes: "",
    alignment: "right" as const,
    bgImage: "/images/emma 2020.jpeg",
  },
];
---

<section
  id="quotes"
  class="max-w-5xl mx-auto px-4 sm:px-6 my-8 sm:my-12 md:my-16"
>
  <!-- Top Decorative Glowing Gradient Line -->
  <div
    class="relative w-full max-w-2xl sm:max-w-3xl mx-auto flex items-center justify-center mb-12 sm:mb-16 md:mb-20"
  >
    <div
      class="w-full h-[1.5px] bg-gradient-to-r from-transparent via-[#E594A5] to-transparent"
    >
    </div>
    <div
      class="absolute w-3/4 h-2.5 bg-gradient-to-r from-transparent via-[#EAA0AF]/40 to-transparent blur-[3px] pointer-events-none"
    >
    </div>
  </div>

  <!-- Subtle decorative label / header -->
  <div class="text-center mb-10 sm:mb-12">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FCF0F3] border border-[#F7D8E0] text-[10px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-[#C76B80] mb-2.5"
    >
      <span>✦</span> LINGERING QUOTES <span>✦</span>
    </div>
  </div>

  <!-- Vertically Staggered Quotes Container -->
  <div class="flex flex-col space-y-7 sm:space-y-9 md:space-y-12">
    {
      quotes.map((quote) => (
        <QuoteCard
          id={quote.id}
          tag={quote.tag}
          quoteText={quote.quoteText}
          author={quote.author}
          likes={quote.likes}
          alignment={quote.alignment}
          bgImage={quote.bgImage}
        />
      ))
    }
  </div>

  <!-- Bottom Decorative Glowing Gradient Line -->
  <div
    class="relative w-full max-w-2xl sm:max-w-3xl mx-auto flex items-center justify-center mt-16 sm:mt-20 md:mt-24 mb-6 sm:mb-8"
  >
    <div
      class="w-full h-[1.5px] bg-gradient-to-r from-transparent via-[#E594A5] to-transparent"
    >
    </div>
    <div
      class="absolute w-3/4 h-2.5 bg-gradient-to-r from-transparent via-[#EAA0AF]/40 to-transparent blur-[3px] pointer-events-none"
    >
    </div>
  </div>
</section>

<script>
  // Intersection Observer for scroll animation
  const observerOptions = {
    root: null,
    rootMargin: '0px',
    threshold: 0.15
  };

  const observer = new IntersectionObserver((entries) => {
    let delay = 0;
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('opacity-100', 'translate-y-0');
          entry.target.classList.remove('opacity-0', 'translate-y-12');
        }, delay);
        delay += 150; // stagger delay
      } else {
        // Reset state when scrolled out of view so it animates again
        entry.target.classList.remove('opacity-100', 'translate-y-0');
        entry.target.classList.add('opacity-0', 'translate-y-12');
      }
    });
  }, observerOptions);

  // Initialize observer after a small delay to ensure DOM is fully ready
  setTimeout(() => {
    document.querySelectorAll('.quote-animate').forEach((el) => {
      observer.observe(el);
    });
  }, 100);

  // Interactive like button handler
  document.querySelectorAll(".like-btn").forEach((button) => {
    const quoteId = button.getAttribute("data-id");
    const storageKey = `liked-${quoteId}`;
    let liked = localStorage.getItem(storageKey) === "true";
    
    const countSpan = button.querySelector(".likes-count");
    const heartIcon = button.querySelector(".heart-icon");
    const rawVal = button.getAttribute("data-likes") || "";

    const updateUI = () => {
      if (liked) {
        button.classList.add(
          "bg-[#FCECEE]",
          "text-[#C76B80]",
          "border-[#F4C4D0]",
        );
        button.classList.remove(
          "bg-[#FAF5F2]",
          "text-[#8C7E7A]",
          "border-[#EFE5E0]",
        );
        if (heartIcon) {
          heartIcon.classList.add("scale-125");
        }
        if (countSpan) {
          if (rawVal.endsWith("k")) {
            const num = parseFloat(rawVal);
            countSpan.textContent = (num + 0.1).toFixed(1) + "k";
          } else {
            const currentNum = parseInt(rawVal, 10) || 0;
            countSpan.textContent = (currentNum + 1).toString();
          }
        }
      } else {
        button.classList.remove(
          "bg-[#FCECEE]",
          "text-[#C76B80]",
          "border-[#F4C4D0]",
        );
        button.classList.add(
          "bg-[#FAF5F2]",
          "text-[#8C7E7A]",
          "border-[#EFE5E0]",
        );
        if (heartIcon) {
          heartIcon.classList.remove("scale-125");
        }
        if (countSpan) {
          countSpan.textContent = rawVal;
        }
      }
    };

    // Set initial UI state
    updateUI();

    button.addEventListener("click", () => {
      liked = !liked;
      if (quoteId) {
        localStorage.setItem(storageKey, liked.toString());
      }
      updateUI();
    });
  });
</script>
